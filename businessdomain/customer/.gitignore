############################################
# MAVEN WRAPPER
############################################
# Si quieres que el wrapper forme parte del repo (recomendado para CI/CD),
# NO ignores estos archivos. Comenta estas líneas si deseas subirlo.
#mvnw
#mvnw.cmd
#.mvn/wrapper/

# Si únicamente deseas ignorar el JAR del wrapper (opción recomendada):
.mvn/wrapper/maven-wrapper.jar


